# Copie para workspace/.env e preencha. Nunca versione o arquivo .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 (padrão): só vagas com Easy Apply no LinkedIn. 0: inclui Indeed e portais de empresas.
EASY_APPLY_ONLY=1

# Leitor por visão (plano B, opcional). Com 1, cada etapa do Easy Apply envia uma imagem da tela
# e o texto do formulário para a API da Anthropic, só para conferir a leitura. A visão nunca clica.
VISION_FALLBACK=0
ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5-5

# Perguntas parecidas: com a chave acima configurada, o Claude compara a pergunta nova da vaga com as
# que você já respondeu (só os textos das perguntas são enviados) e a sugestão vira um botão "Usar" no
# Telegram. 0 desliga a API e usa só a comparação local por palavras em comum.
SIMILAR_QUESTIONS_AI=1
